# JobFit frontend — environment template
# Copy to frontend/.env and fill in. Values here stay empty.
# Vite only exposes variables prefixed with VITE_, and they ship in the browser bundle:
# never put the Supabase secret key here.

# Backend base URL (no trailing slash). The deployed Render URL in production.
VITE_API_BASE_URL=http://localhost:8000

# Supabase → Project Settings → API keys. The publishable (anon) key is meant to be public;
# RLS and the backend's auth checks are what protect the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
