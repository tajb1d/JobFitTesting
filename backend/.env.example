# JobFit backend — environment template
# Copy to backend/.env and fill in. Values here stay empty.

# --- Database -------------------------------------------------------------
# Supabase -> Connect -> Session pooler (IPv4). Swap the prefix to
# postgresql+psycopg:// and fill in your database password.
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Supabase -------------------------------------------------------------
# Project Settings -> API keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Third-party APIs -----------------------------------------------------
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# --- App ------------------------------------------------------------------
# Comma-separated. Add your Vercel URL when the frontend is deployed.
CORS_ORIGINS=http://localhost:5173

# --- Test user (for scripts/get_token.py) ---------------------------------
# The Supabase Authentication -> Users account you created in Session 0.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
